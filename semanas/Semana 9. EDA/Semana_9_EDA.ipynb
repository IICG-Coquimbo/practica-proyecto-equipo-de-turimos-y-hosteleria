  {
   "cell_type": "markdown",
   "id": "7779b1c5-d97c-4a2d-a337-2b5306a8576b",
   "metadata": {},
   "source": [
    "## 2. Normalización de Precios (CLP a EUR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "32314715-a8fd-4417-8e50-d1730b7905d3",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convertimos el precio a numérico y normalizamos a una sola moneda (EUR)\n",
    "df_clean = df_clean.withColumn(\"precio_num\", col(\"precio_noche\").cast(\"double\"))\n",
    "\n",
    "# Como tus datos están en pesos chilenos, los dividimos por 980 para pasarlos a EUR\n",
    "df_clean = df_clean.withColumn(\"precio_eur\", col(\"precio_num\") / 980)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9719a686-f08e-4f1b-94fc-5a79f4a797ea",
   "metadata": {},
   "source": [
    "## 3. Extracción de Peso (Bioingeniería de Variables)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "19e6ab42-78e5-4360-b455-cbfe3f0d1551",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pyspark.sql.functions import col, regexp_extract, regexp_replace, when\n",
    "\n",
    "# 1. Extraemos el número de estrellas del texto\n",
    "# 2. Usamos regexp_replace para limpiar cualquier impureza antes del cast\n",
    "df_clean = df_clean.withColumn(\"estrellas_num\", \n",
    "    regexp_replace(\n",
    "        regexp_extract(col(\"estrellas\"), r\"(\\d+)\", 1), \n",
    "        \",\", \".\"\n",
    "    ).cast(\"double\"))\n",
    "\n",
    "# 3. Normalización: Si el hotel no tiene estrellas (nulo o vacío), le asignamos 0\n",
    "df_clean = df_clean.withColumn(\"estrellas_num\",\n",
    "    when(\n",
    "        col(\"estrellas\").contains(\"Desconocido\") | col(\"estrellas_num\").isNull(), \n",
    "        0.0\n",
    "    ).otherwise(col(\"estrellas_num\")))"
   ]
  },
